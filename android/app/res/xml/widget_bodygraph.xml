<?xml version="1.0" encoding="utf-8"?>
<!-- Android draws a widget again every half hour at most by itself, the widget asks for the moments in between -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp" android:minHeight="110dp" android:targetCellWidth="4" android:targetCellHeight="2"
    android:minResizeWidth="110dp" android:minResizeHeight="110dp" android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000" android:initialLayout="@layout/widget" android:widgetCategory="home_screen"
    android:previewImage="@drawable/preview_bodygraph" android:description="@string/bodygraph_description"/>
